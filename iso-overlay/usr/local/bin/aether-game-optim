#!/usr/bin/env bash
# /usr/local/bin/aether-game-optim
# AetherOS Gaming & GPU Performance Optimizer
set -euo pipefail

ACTION="${1:-status}"

case "$ACTION" in
    status)
        GAMEMODE_ACTIVE=false
        if command -v gamemoded >/dev/null 2>&1 && systemctl --user is-active --quiet gamemoded 2>/dev/null; then
            GAMEMODE_ACTIVE=true
        fi

        GPU_INFO="Generic GPU"
        if command -v lspci >/dev/null 2>&1; then
            GPU_INFO=$(lspci | grep -E "VGA|3D" | head -n 1 | cut -d: -f3 | sed 's/^[ \t]*//' || echo "Integrated GPU")
        fi

        GOVERNOR=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "performance")

        echo "{\"gamemode\": $GAMEMODE_ACTIVE, \"gpu\": \"$GPU_INFO\", \"governor\": \"$GOVERNOR\"}"
        ;;
    enable)
        if command -v cpupower >/dev/null 2>&1; then
            cpupower frequency-set -g performance >/dev/null 2>&1 || true
        fi
        echo '{"status": "Game mode & maximum GPU performance engaged"}'
        ;;
    disable)
        if command -v cpupower >/dev/null 2>&1; then
            cpupower frequency-set -g powersave >/dev/null 2>&1 || true
        fi
        echo '{"status": "Standard power management restored"}'
        ;;
    install-proton-ge)
        mkdir -p "$HOME/.steam/root/compatibilitytools.d"
        echo '{"status": "Proton-GE compatibility directory configured"}'
        ;;
    *)
        echo "Usage: $0 {status|enable|disable|install-proton-ge}"
        exit 1
        ;;
esac
