#!/usr/bin/env python3
"""
AetherOS VPN & WireGuard Manager
Connects, disconnects, and manages WireGuard and OpenVPN tunnels via NetworkManager & wg-quick.
"""

import sys
import os
import subprocess
import json

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        return res.stdout.strip()
    except Exception:
        return ""

def list_vpns():
    nm_out = run_cmd(["nmcli", "-t", "-f", "NAME,TYPE,STATE,DEVICE", "connection", "show"])
    vpns = []
    for line in nm_out.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and any(t in parts[1].lower() for t in ["vpn", "wireguard"]):
            vpns.append({
                "name": parts[0],
                "type": parts[1],
                "active": parts[2] if len(parts) > 2 else "inactive",
                "device": parts[3] if len(parts) > 3 else ""
            })
            
    # Also check /etc/wireguard/*.conf
    if os.path.exists("/etc/wireguard"):
        for f in os.listdir("/etc/wireguard"):
            if f.endswith(".conf"):
                name = f[:-5]
                is_active = subprocess.run(["wg", "show", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
                if not any(v["name"] == name for v in vpns):
                    vpns.append({
                        "name": name,
                        "type": "wireguard-raw",
                        "active": "activated" if is_active else "inactive",
                        "device": name if is_active else ""
                    })
    return vpns

def connect_vpn(name):
    # Try nmcli first
    res = subprocess.run(["nmcli", "connection", "up", name])
    if res.returncode != 0 and os.path.exists(f"/etc/wireguard/{name}.conf"):
        res = subprocess.run(["wg-quick", "up", name])
    return res.returncode == 0

def disconnect_vpn(name):
    res = subprocess.run(["nmcli", "connection", "down", name])
    if res.returncode != 0:
        res = subprocess.run(["wg-quick", "down", name])
    return res.returncode == 0

def import_config(filepath):
    if not os.path.exists(filepath):
        sys.exit(f"File {filepath} not found.")
    res = subprocess.run(["nmcli", "connection", "import", "type", "wireguard", "file", filepath])
    if res.returncode != 0:
        res = subprocess.run(["nmcli", "connection", "import", "type", "openvpn", "file", filepath])
    return res.returncode == 0

def main():
    if len(sys.argv) < 2 or sys.argv[1] == "list" or sys.argv[1] == "status":
        print(json.dumps(list_vpns(), indent=2))
    elif sys.argv[1] == "connect" and len(sys.argv) >= 3:
        success = connect_vpn(sys.argv[2])
        sys.exit(0 if success else 1)
    elif sys.argv[1] == "disconnect" and len(sys.argv) >= 3:
        success = disconnect_vpn(sys.argv[2])
        sys.exit(0 if success else 1)
    elif sys.argv[1] == "import" and len(sys.argv) >= 3:
        if os.geteuid() != 0:
            sys.exit("Root privileges required.")
        success = import_config(sys.argv[2])
        sys.exit(0 if success else 1)
    else:
        print("Usage: aether-vpn [list|status|connect <name>|disconnect <name>|import <config_path>]")

if __name__ == "__main__":
    main()
