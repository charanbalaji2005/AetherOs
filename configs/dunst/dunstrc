# AetherOS Glassmorphic Dunst Notification Configuration

[global]
    monitor = 0
    follow = mouse
    width = 340
    height = 200
    origin = top-right
    offset = 18x48
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 2

    transparency = 15
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#9d4edd"
    gap_size = 8
    separator_color = frame
    sort = yes
    font = Segoe UI, Outfit, sans-serif 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    corner_radius = 12
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0d1117ee"
    foreground = "#e6f1f5"
    frame_color = "#56d4dd"
    timeout = 4

[urgency_normal]
    background = "#0d1117ee"
    foreground = "#e6f1f5"
    frame_color = "#9d4edd"
    timeout = 6

[urgency_critical]
    background = "#1a0b1cee"
    foreground = "#ff6b6b"
    frame_color = "#ff6b6b"
    timeout = 0
