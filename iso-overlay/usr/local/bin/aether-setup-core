#!/usr/bin/env bash
# /usr/local/bin/aether-setup-core
# AetherOS Privileged First-Boot Configuration & Secure User Creation Engine
# Passwords are read strictly via stdin and hashed with Fedora YESCRYPT
set -euo pipefail

ACTION="${1:-list-timezones}"

# ---------------------------------------------------------
# Action: list-timezones
# ---------------------------------------------------------
if [ "$ACTION" == "list-timezones" ]; then
    timedatectl list-timezones 2>/dev/null || echo -e "UTC\nAmerica/New_York\nEurope/London\nAsia/Tokyo"
    exit 0
fi

# ---------------------------------------------------------
# Action: scan-wifi
# ---------------------------------------------------------
if [ "$ACTION" == "scan-wifi" ]; then
    if command -v nmcli &>/dev/null; then
        nmcli -t -f SSID,SIGNAL,SECURITY dev wifi list --rescan yes 2>/dev/null | awk -F: '$1 != "" {print $1":"$2":"$3}' | sort -u || true
    fi
    exit 0
fi

# ---------------------------------------------------------
# Action: connect-wifi
# ---------------------------------------------------------
if [ "$ACTION" == "connect-wifi" ]; then
    SSID="${2:-}"
    PASSWORD="${3:-}"
    if [ -z "$SSID" ]; then
        echo "Error: SSID required." >&2
        exit 1
    fi
    if [ -z "$PASSWORD" ]; then
        nmcli dev wifi connect "$SSID"
    else
        nmcli dev wifi connect "$SSID" password "$PASSWORD"
    fi
    exit $?
fi

# ---------------------------------------------------------
# Action: create-user (Secure Stdin Password Reader)
# ---------------------------------------------------------
if [ "$ACTION" == "create-user" ] || [ "$#" -eq 2 ]; then
    if [ "$ACTION" == "create-user" ]; then
        USERNAME="${2:-aether}"
        FULLNAME="${3:-Aether User}"
    else
        USERNAME="$1"
        FULLNAME="$2"
    fi

    # Read the password from stdin securely (prevents leaking in ps aux / process tables)
    read -r PASSWORD

    # 1. Create user with home directory and assign default shell
    if ! id -u "$USERNAME" >/dev/null 2>&1; then
        useradd -m -c "$FULLNAME" -s /bin/bash "$USERNAME"
    fi

    # 2. Add user to the wheel and hardware groups
    usermod -aG wheel,video,audio,input "$USERNAME" 2>/dev/null || usermod -aG wheel "$USERNAME"

    # 3. Hash and apply the password using Fedora's YESCRYPT algorithm
    echo "$USERNAME:$PASSWORD" | chpasswd -c YESCRYPT

    echo "User $USERNAME successfully created and configured."
    exit 0
fi

# ---------------------------------------------------------
# Action: apply-setup (Comprehensive First-Boot Engine with Stdin Password)
# ---------------------------------------------------------
if [ "$ACTION" == "apply-setup" ]; then
    USERNAME="${2:-aether}"
    FULLNAME="${3:-Aether User}"
    TIMEZONE="${4:-UTC}"
    HOSTNAME="${5:-aether-workstation}"
    LANGUAGE="${6:-en_US.UTF-8}"
    COUNTRY="${7:-us}"

    # Read password securely from stdin
    read -r PASSWORD

    # 1. Apply Language and Keyboard Layout
    if command -v localectl &>/dev/null; then
        localectl set-locale LANG="$LANGUAGE" 2>/dev/null || true
        localectl set-x11-keymap "$COUNTRY" 2>/dev/null || true
    fi

    # 2. Set Timezone
    if [ -n "$TIMEZONE" ] && command -v timedatectl &>/dev/null; then
        timedatectl set-timezone "$TIMEZONE" 2>/dev/null || true
    fi

    # 3. Set Hostname
    if command -v hostnamectl &>/dev/null; then
        hostnamectl set-hostname "$HOSTNAME" 2>/dev/null || true
    fi

    # 4. Create User & Apply YESCRYPT password
    if ! id -u "$USERNAME" >/dev/null 2>&1; then
        useradd -m -c "$FULLNAME" -s /bin/bash "$USERNAME" 2>/dev/null || true
    fi
    usermod -aG wheel,video,audio,input "$USERNAME" 2>/dev/null || usermod -aG wheel "$USERNAME" 2>/dev/null || true
    echo "$USERNAME:$PASSWORD" | chpasswd -c YESCRYPT 2>/dev/null || echo "$USERNAME:$PASSWORD" | chpasswd 2>/dev/null || true

    # 5. Populate user dotfiles from /etc/skel
    if [ -d "/home/$USERNAME" ] && [ -d /etc/skel/.config ]; then
        mkdir -p "/home/$USERNAME/.config"
        cp -rf /etc/skel/.config/* "/home/$USERNAME/.config/" 2>/dev/null || true
        chown -R "$USERNAME:$USERNAME" "/home/$USERNAME" 2>/dev/null || true
    fi

    # 6. Mark first-boot as complete
    mkdir -p /var/lib
    touch /var/lib/aether-setup-complete
    echo "SETUP_SUCCESS"
    exit 0
fi
