{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1421",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "aether-powermenu",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "identifier": "com.aetheros.powermenu"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Aether Power Menu",
        "width": 1000,
        "height": 450,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  }
}
