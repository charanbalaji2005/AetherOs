#!/usr/bin/env bash
# /usr/local/bin/aether-firewall-core
# AetherOS Native Firewall Controller (firewalld wrapper)
set -euo pipefail

ACTION="${1:-status}"

case "$ACTION" in
    status)
        ACTIVE=false
        ZONE="public"
        PORTS=""
        PANIC=false

        if systemctl is-active --quiet firewalld; then
            ACTIVE=true
            ZONE=$(firewall-cmd --get-default-zone 2>/dev/null || echo "public")
            PORTS=$(firewall-cmd --list-ports 2>/dev/null || echo "")
            PANIC=$(firewall-cmd --query-panic 2>/dev/null && echo "true" || echo "false")
        fi

        echo "{\"active\": $ACTIVE, \"zone\": \"$ZONE\", \"ports\": \"$PORTS\", \"panic\": $PANIC}"
        ;;
    enable)
        systemctl enable --now firewalld
        echo '{"status": "Firewall enabled"}'
        ;;
    disable)
        systemctl disable --now firewalld
        echo '{"status": "Firewall disabled"}'
        ;;
    add-port)
        PORT="${2:-}"
        if [ -n "$PORT" ]; then
            firewall-cmd --permanent --add-port="$PORT"
            firewall-cmd --reload
            echo "{\"status\": \"Port $PORT allowed\"}"
        else
            echo '{"error": "Missing port"}' >&2
            exit 1
        fi
        ;;
    remove-port)
        PORT="${2:-}"
        if [ -n "$PORT" ]; then
            firewall-cmd --permanent --remove-port="$PORT"
            firewall-cmd --reload
            echo "{\"status\": \"Port $PORT removed\"}"
        else
            echo '{"error": "Missing port"}' >&2
            exit 1
        fi
        ;;
    panic-on)
        firewall-cmd --panic-on
        echo '{"status": "Panic mode engaged: All network traffic blocked"}'
        ;;
    panic-off)
        firewall-cmd --panic-off
        echo '{"status": "Panic mode disengaged"}'
        ;;
    *)
        echo "Usage: $0 {status|enable|disable|add-port <p/proto>|remove-port <p/proto>|panic-on|panic-off}"
        exit 1
        ;;
esac
