#!/usr/bin/env python3
"""
AetherOS Software & Package Center
Unified package management engine supporting Flatpak/Flathub and DNF5.
"""

import sys
import os
import subprocess
import json

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        return res.stdout.strip()
    except Exception:
        return ""

def search_apps(query):
    results = []
    # Search Flatpak
    flatpak_out = run_cmd(["flatpak", "search", query])
    for line in flatpak_out.splitlines()[:15]:
        parts = [p.strip() for p in line.split("\t") if p.strip()]
        if len(parts) >= 3:
            results.append({
                "source": "flatpak",
                "name": parts[0],
                "description": parts[1],
                "app_id": parts[2],
                "version": parts[3] if len(parts) > 3 else "latest"
            })
            
    # Search DNF
    dnf_out = run_cmd(["dnf", "search", query])
    for line in dnf_out.splitlines()[:15]:
        if " : " in line:
            name, desc = line.split(" : ", 1)
            results.append({
                "source": "dnf",
                "name": name.strip(),
                "description": desc.strip(),
                "app_id": name.strip().split(".")[0],
                "version": "repo"
            })
    return results

def list_installed():
    installed = []
    # Flatpak installed
    flat_out = run_cmd(["flatpak", "list", "--app", "--columns=name,application,version"])
    for line in flat_out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            installed.append({
                "source": "flatpak",
                "name": parts[0].strip(),
                "app_id": parts[1].strip(),
                "version": parts[2].strip() if len(parts) > 2 else ""
            })
    return installed

def install_app(app_id, source="flatpak"):
    if source == "flatpak":
        res = subprocess.run(["flatpak", "install", "-y", "flathub", app_id])
    else:
        res = subprocess.run(["dnf", "install", "-y", app_id])
    return res.returncode == 0

def remove_app(app_id, source="flatpak"):
    if source == "flatpak":
        res = subprocess.run(["flatpak", "uninstall", "-y", app_id])
    else:
        res = subprocess.run(["dnf", "remove", "-y", app_id])
    return res.returncode == 0

def main():
    if len(sys.argv) < 2 or sys.argv[1] == "list":
        print(json.dumps(list_installed(), indent=2))
    elif sys.argv[1] == "search" and len(sys.argv) >= 3:
        query = sys.argv[2]
        print(json.dumps(search_apps(query), indent=2))
    elif sys.argv[1] == "install" and len(sys.argv) >= 3:
        source = sys.argv[3] if len(sys.argv) > 3 else "flatpak"
        success = install_app(sys.argv[2], source)
        sys.exit(0 if success else 1)
    elif sys.argv[1] == "remove" and len(sys.argv) >= 3:
        source = sys.argv[3] if len(sys.argv) > 3 else "flatpak"
        success = remove_app(sys.argv[2], source)
        sys.exit(0 if success else 1)
    else:
        print("Usage: aether-software-center [list|search <query>|install <app_id> [flatpak|dnf]|remove <app_id> [flatpak|dnf]]")

if __name__ == "__main__":
    main()
