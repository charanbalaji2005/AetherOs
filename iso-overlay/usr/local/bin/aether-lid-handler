#!/usr/bin/env bash
# /usr/local/bin/aether-lid-handler
set -euo pipefail

# Under GNOME, systemd-logind and GNOME Mutter manage laptop lid switch events natively
if [ "${XDG_CURRENT_DESKTOP:-}" = "GNOME" ] || [ "${XDG_CURRENT_DESKTOP:-}" = "ubuntu:GNOME" ]; then
    exit 0
fi

# Count connected displays
MONITOR_COUNT=$(hyprctl monitors 2>/dev/null | grep -c "Monitor" || echo 1)

if [ "$MONITOR_COUNT" -gt 1 ]; then
    # Clamshell mode: disable internal laptop screen if external monitor is active
    hyprctl keyword monitor eDP-1, disable 2>/dev/null || true
else
    # Single monitor / standalone laptop: trigger sleep
    systemctl suspend
fi
