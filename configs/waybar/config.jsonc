// AetherOS - Fedora-style Top Bar with Cyber-Glass Aesthetic
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 4,

    "modules-left": [
        "custom/activities",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "battery",
        "custom/power"
    ],

    "custom/activities": {
        "format": "󰢻 Activities",
        "tooltip-format": "Open Application Grid (Super+Space)",
        "on-click": "wofi --show drun"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 4
        }
    },

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "{usage}% 󰍛",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "{percentage}% 󰘚",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used",
        "interval": 3
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Online",
        "format-disconnected": "󰤭 Disconnected",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "format": "{capacity}% 󰁹",
        "format-charging": "{capacity}% 󰂄",
        "states": { "warning": 20, "critical": 10 },
        "interval": 5
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Options",
        "on-click": "aether power"
    }
}
