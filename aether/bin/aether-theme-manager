#!/usr/bin/env bash
# /usr/local/bin/aether-theme-manager
# Usage: aether-theme-manager [sddm|desktop] [theme-name]

set -euo pipefail

TARGET="${1:-desktop}"
THEME="${2:-cyberpunk}"

if [ "$TARGET" == "sddm" ]; then
    mkdir -p /etc/sddm.conf.d
    echo -e "[Theme]\nCurrent=$THEME\nThemeDir=/usr/share/sddm/themes\n" > /etc/sddm.conf.d/10-theme.conf
    echo "SDDM theme '$THEME' staged for next login."
elif [ "$TARGET" == "desktop" ]; then
    THEME_DIR="/usr/share/aether/themes/$THEME"
    USER_CONFIG="${HOME:-/home/aether}/.config"

    if [ -d "$THEME_DIR" ]; then
        if [ -f "$THEME_DIR/hyprland.conf" ]; then
            cp -f "$THEME_DIR/hyprland.conf" "$USER_CONFIG/hypr/theme.conf"
        fi
        if [ -f "$THEME_DIR/waybar.css" ]; then
            cp -f "$THEME_DIR/waybar.css" "$USER_CONFIG/waybar/style.css"
        fi
        if [ -f "$THEME_DIR/wallpaper.png" ]; then
            /usr/local/bin/aether-wallpaper "$THEME_DIR/wallpaper.png" 2>/dev/null || true
        fi
    fi

    # Reload compositor and Waybar UI live without logout
    hyprctl reload 2>/dev/null || true
    killall -SIGUSR2 waybar 2>/dev/null || true
    echo "Desktop theme '$THEME' applied live."
fi
