#!/usr/bin/env python3
"""
AetherOS Power & Battery Management Daemon
Monitors AC state, power levels, and dynamically applies CPU power profiles.
"""

import sys
import os
import time
import subprocess

def get_power_status():
    supply_dir = "/sys/class/power_supply"
    if not os.path.exists(supply_dir):
        return None, None

    online = False
    capacity = 100

    for name in os.listdir(supply_dir):
        path = os.path.join(supply_dir, name)
        type_file = os.path.join(path, "type")
        
        if os.path.exists(type_file):
            with open(type_file, "r") as f:
                t = f.read().strip()
                if t == "Mains":
                    online_file = os.path.join(path, "online")
                    if os.path.exists(online_file):
                        with open(online_file, "r") as of:
                            online = (of.read().strip() == "1")
                elif t == "Battery":
                    cap_file = os.path.join(path, "capacity")
                    if os.path.exists(cap_file):
                        with open(cap_file, "r") as cf:
                            try:
                                capacity = int(cf.read().strip())
                            except ValueError:
                                pass

    return online, capacity

def set_power_profile(profile):
    try:
        subprocess.run(["powerprofilesctl", "set", profile], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    last_profile = ""
    while True:
        online, capacity = get_power_status()
        
        if online is not None:
            if online:
                profile = "performance"
            elif capacity and capacity < 20:
                profile = "power-saver"
            else:
                profile = "balanced"

            if profile != last_profile:
                set_power_profile(profile)
                last_profile = profile

        time.sleep(10)

if __name__ == "__main__":
    main()
