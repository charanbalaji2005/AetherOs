#!/usr/bin/env bash
# /usr/local/bin/aether-sync-sddm (Display Manager Theme & Wallpaper Sync)
set -euo pipefail

NEW_WALLPAPER="${1:-/usr/share/backgrounds/aetheros/sunset_mountains.png}"

if [ ! -f "$NEW_WALLPAPER" ]; then
    echo "Notice: Wallpaper file not found: $NEW_WALLPAPER" >&2
    exit 0
fi

# 1. Sync for GDM & AccountsService
TARGET_USER="${USER:-liveuser}"
if [ -d /var/lib/AccountsService/users ]; then
    mkdir -p /var/lib/AccountsService/users
    sed -i "s|^Icon=.*|Icon=$NEW_WALLPAPER|" "/var/lib/AccountsService/users/$TARGET_USER" 2>/dev/null || true
fi

# 2. Sync for SDDM (if installed)
for tdir in "/usr/share/sddm/themes/aether/assets" "/usr/share/sddm/themes/aetheros-glass/assets"; do
    if [ -d "$tdir" ]; then
        cp -f "$NEW_WALLPAPER" "$tdir/background.png" 2>/dev/null || true
        cp -f "$NEW_WALLPAPER" "$tdir/background.jpg" 2>/dev/null || true
    fi
done

echo "Display Manager background synced successfully."
