#!/usr/bin/env python3
"""
AetherOS Security & Firewall Manager
Integrates Firewalld, SELinux policies, and network port controls.
"""

import sys
import os
import subprocess
import json

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        return res.stdout.strip()
    except Exception:
        return ""

def get_security_status():
    fw_running = subprocess.run(["systemctl", "is-active", "firewalld"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    active_zone = run_cmd(["firewall-cmd", "--get-default-zone"]) if fw_running else "inactive"
    open_ports = run_cmd(["firewall-cmd", "--list-ports"]).split() if fw_running else []
    active_services = run_cmd(["firewall-cmd", "--list-services"]).split() if fw_running else []
    
    selinux_mode = run_cmd(["getenforce"])
    if not selinux_mode:
        selinux_mode = "Disabled"
        
    return {
        "firewall": {
            "active": fw_running,
            "default_zone": active_zone,
            "ports": open_ports,
            "services": active_services
        },
        "selinux": {
            "mode": selinux_mode
        }
    }

def toggle_firewall(enable: bool):
    action = "start" if enable else "stop"
    enable_cmd = "enable" if enable else "disable"
    subprocess.run(["systemctl", action, "firewalld"])
    subprocess.run(["systemctl", enable_cmd, "firewalld"])

def allow_port(port: str, protocol="tcp"):
    subprocess.run(["firewall-cmd", "--permanent", f"--add-port={port}/{protocol}"])
    subprocess.run(["firewall-cmd", "--reload"])

def remove_port(port: str, protocol="tcp"):
    subprocess.run(["firewall-cmd", "--permanent", f"--remove-port={port}/{protocol}"])
    subprocess.run(["firewall-cmd", "--reload"])

def set_selinux(mode: str):
    if mode.lower() == "enforcing":
        subprocess.run(["setenforce", "1"])
    elif mode.lower() == "permissive":
        subprocess.run(["setenforce", "0"])

def main():
    if len(sys.argv) < 2 or sys.argv[1] == "status":
        print(json.dumps(get_security_status(), indent=2))
    elif sys.argv[1] == "enable-firewall":
        if os.geteuid() != 0:
            sys.exit("Root privileges required.")
        toggle_firewall(True)
        print("Firewall enabled.")
    elif sys.argv[1] == "disable-firewall":
        if os.geteuid() != 0:
            sys.exit("Root privileges required.")
        toggle_firewall(False)
        print("Firewall disabled.")
    elif sys.argv[1] == "allow-port" and len(sys.argv) >= 3:
        if os.geteuid() != 0:
            sys.exit("Root privileges required.")
        allow_port(sys.argv[2])
        print(f"Port {sys.argv[2]} allowed.")
    elif sys.argv[1] == "remove-port" and len(sys.argv) >= 3:
        if os.geteuid() != 0:
            sys.exit("Root privileges required.")
        remove_port(sys.argv[2])
        print(f"Port {sys.argv[2]} removed.")
    elif sys.argv[1] == "set-selinux" and len(sys.argv) >= 3:
        if os.geteuid() != 0:
            sys.exit("Root privileges required.")
        set_selinux(sys.argv[2])
        print(f"SELinux set to {sys.argv[2]}.")
    else:
        print("Usage: aether-security-center [status|enable-firewall|disable-firewall|allow-port <port>|remove-port <port>|set-selinux <Enforcing|Permissive>]")

if __name__ == "__main__":
    main()
