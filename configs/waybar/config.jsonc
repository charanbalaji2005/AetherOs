// AetherOS Cyberpunk Waybar config
// High-end glassmorphic top bar with purple accents and real hardware telemetry
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 6,

    "modules-left": ["custom/logo", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "battery",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "custom/power"
    ],

    "custom/logo": {
        "format": "󰢻 Hyprland",
        "tooltip-format": "AetherOS Hyprland Desktop",
        "on-click": "wofi --show drun"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%b %d | %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "format": "{capacity}% 󰁹",
        "format-charging": "{capacity}% 󰂄",
        "states": { "warning": 20, "critical": 10 },
        "interval": 5
    },

    "cpu": {
        "format": "{usage}% 󰍛",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "{percentage}% 󰘚",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used",
        "interval": 3
    },

    "pulseaudio": {
        "format": "{volume}% 󰕾",
        "format-muted": "muted 󰖁",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "on-click": "nm-connection-editor"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Options",
        "on-click": "aether power"
    }
}
