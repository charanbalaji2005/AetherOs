# /etc/yum.repos.d/aether.repo
# Official AetherOS Rolling Updates & Kernel Channel
[aether-os]
name=AetherOS Official Updates
baseurl=https://charanbalaji2005.github.io/AetherOs/
enabled=1
gpgcheck=0
type=rpm-md
skip_if_unavailable=True
metadata_expire=6h
# Priority 1 ensures AetherOS packages take precedence over Fedora (99) and RPM Fusion (50)
priority=1
cost=500
