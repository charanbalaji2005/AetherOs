if [ -d /home/aether ]; then
  mkdir -p /home/aether/.config
  cp -r /etc/skel/.config/* /home/aether/.config/
  chown -R aether:aether /home/aether
  chmod +x /home/aether/.config/waybar/scripts/*.sh 2>/dev/null || true
fi

%end
