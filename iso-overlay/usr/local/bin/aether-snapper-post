#!/usr/bin/env bash
# /usr/local/bin/aether-snapper-post
# Takes a post-transaction snapshot linked to the pre-snapshot
set -euo pipefail

DESCRIPTION="${1:-Package Transaction}"

if [ -f /tmp/snapper-pre-id ]; then
    PRE_ID=$(cat /tmp/snapper-pre-id 2>/dev/null || echo "")
    if [ -n "$PRE_ID" ] && snapper -c root get-config >/dev/null 2>&1; then
        snapper -c root create -t post -p -d "DNF5: $DESCRIPTION complete" --pre-number "$PRE_ID" 2>/dev/null || true
    fi
    rm -f /tmp/snapper-pre-id
fi
