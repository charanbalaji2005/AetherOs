// AetherOS - Minimalist Bottom Floating Dock Pill (Reference Image 1)
{
    "layer": "top",
    "position": "bottom",
    "height": 44,
    "margin-bottom": 12,
    "spacing": 8,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "󰢻",
        "tooltip-format": "Open Application Launcher (Super+Space)",
        "on-click": "rofi -show drun || wofi --show drun"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰄯",
            "2": "󰄯",
            "3": "󰄯",
            "4": "󰄯",
            "active": "󰄰",
            "default": "󰄯"
        },
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 4
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 22,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "AetherOS Splash",
            "Aether Power Menu"
        ]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "Volume: {volume}%"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "Wired ({ipaddr})",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{capacity}% ({time})"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Menu (Super+Escape)",
        "on-click": "aether-powermenu"
    }
}
