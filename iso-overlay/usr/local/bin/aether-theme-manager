#!/usr/bin/env bash
# /usr/local/bin/aether-theme-manager
# Usage: aether-theme-manager [sddm|desktop|mode] [theme-name|dark|light]
set -euo pipefail

TARGET="${1:-desktop}"
THEME="${2:-cyberpunk}"

# 1. Mode Switcher (Dark / Light) for both GNOME and Hyprland
if [ "$TARGET" == "mode" ]; then
    case "$THEME" in
        dark)
            if command -v gsettings >/dev/null 2>&1; then
                gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
                gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null || true
            fi
            if [ -f "$HOME/.config/hypr/theme.conf" ]; then
                sed -i 's/col.active_border = .*/col.active_border = rgba(33ccffee) rgba(00ff99ee) 45deg/' "$HOME/.config/hypr/theme.conf" 2>/dev/null || true
            fi
            ;;
        light)
            if command -v gsettings >/dev/null 2>&1; then
                gsettings set org.gnome.desktop.interface color-scheme 'default' 2>/dev/null || true
                gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita' 2>/dev/null || true
            fi
            if [ -f "$HOME/.config/hypr/theme.conf" ]; then
                sed -i 's/col.active_border = .*/col.active_border = rgba(ffffffaa) 45deg/' "$HOME/.config/hypr/theme.conf" 2>/dev/null || true
            fi
            ;;
    esac
    exit 0
fi

# 2. Display Manager sync
if [ "$TARGET" == "sddm" ] || [ "$TARGET" == "gdm" ]; then
    if [ -f "/usr/local/bin/aether-sync-sddm" ]; then
        /usr/local/bin/aether-sync-sddm "/usr/share/backgrounds/aetheros/$THEME.png" 2>/dev/null || true
    fi
    exit 0
fi

# 3. Desktop Theme Switcher
if [ "$TARGET" == "desktop" ]; then
    THEME_DIR="/usr/share/aether/themes/$THEME"
    USER_CONFIG="${HOME:-/home/aether}/.config"

    if [ -d "$THEME_DIR" ]; then
        if [ -f "$THEME_DIR/hyprland.conf" ]; then
            mkdir -p "$USER_CONFIG/hypr"
            cp -f "$THEME_DIR/hyprland.conf" "$USER_CONFIG/hypr/theme.conf"
        fi
        if [ -f "$THEME_DIR/waybar.css" ]; then
            mkdir -p "$USER_CONFIG/waybar"
            cp -f "$THEME_DIR/waybar.css" "$USER_CONFIG/waybar/style.css"
        fi
        if [ -f "$THEME_DIR/wallpaper.png" ]; then
            /usr/local/bin/aether-wallpaper "$THEME_DIR/wallpaper.png" 2>/dev/null || true
        fi
    fi

    # GNOME Dark Mode & Appearance Sync
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null || true
    fi

    # Hyprland live reload
    hyprctl reload 2>/dev/null || true
    killall -SIGUSR2 waybar 2>/dev/null || true
    echo "Desktop theme '$THEME' applied live."
fi
